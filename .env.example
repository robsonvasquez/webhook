# Copie para .env (uso local) ou configure como "Environment Variables"
# no painel do Render. Nenhum destes valores deve ir para o git.

# IP/domínio, porta e credenciais da câmera Hikvision (usadas para chamar
# de volta a API ISAPI dela: whitelist e acionamento de barreira).
CAMERA_HOST=177.74.253.72
CAMERA_PORT=8420
CAMERA_USER=admin
CAMERA_PASS=
CAMERA_USE_HTTPS=false

# Se "true", ao reconhecer uma placa da whitelist (PLACAS_AUTORIZADAS) o
# script aciona a barreira automaticamente. Deixe "false" até validar o
# fluxo em produção.
AUTO_ABRIR_BARREIRA=false

# Placas de teste autorizadas, separadas por vírgula.
PLACAS_AUTORIZADAS=TEST1234

# URL do backend real para onde cada evento decodificado é repassado
# via POST JSON. Deixe em branco para não encaminhar.
BACKEND_WEBHOOK_URL=
